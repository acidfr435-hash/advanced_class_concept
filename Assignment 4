memo = {0: 0, 1: 1}

def fib_memo(n):
    if n in memo:
        return memo[n]
    
    memo[n] = fib_memo(n - 1) + fib_memo(n - 2)
    return memo[n]


def fib_table(n):
    if n <= 1:
        return n
        
    table = [0, 1]
    
    for _ in range(2, n + 1):
        next_number = table[-1] + table[-2]
        table.append(next_number)
        
    return table[-1]


print("Memoization result:", fib_memo(10))
print("Tabulation result:", fib_table(10))

# Output:
# Memoization result: 55
# Tabulation result: 55
